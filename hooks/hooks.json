{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "name": "bluer-session-start", "type": "command", "command": "sh \"${extensionPath}/plugins/claude-code/bin/bluer\" hook gemini-cli session-start", "timeout": 10000 }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          { "name": "bluer-prompt", "type": "command", "command": "sh \"${extensionPath}/plugins/claude-code/bin/bluer\" hook gemini-cli user-prompt-submit", "timeout": 10000 }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "^activate_skill$",
        "hooks": [
          { "name": "bluer-skill-loaded", "type": "command", "command": "sh \"${extensionPath}/plugins/claude-code/bin/bluer\" hook gemini-cli post-tool-use", "timeout": 10000 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "name": "bluer-session-end", "type": "command", "command": "sh \"${extensionPath}/plugins/claude-code/bin/bluer\" hook gemini-cli session-end", "timeout": 30000 }
        ]
      }
    ]
  }
}
